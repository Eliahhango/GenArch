# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Ollama Cloud API (https://ollama.com/settings/keys)
OLLAMA_API_KEY=your-ollama-cloud-key-here

# Ollama local host (default: http://localhost:11434)
# Change this if running Ollama on a different machine
OLLAMA_HOST=http://localhost:11434

# Default AI backend: deepseek | ollama-local | ollama-cloud
DEFAULT_BACKEND=deepseek

# Default model per backend (optional overrides)
DEEPSEEK_MODEL=deepseek-v4-pro
OLLAMA_LOCAL_MODEL=qwen3-coder
OLLAMA_CLOUD_MODEL=deepseek-v3.1:671b-cloud

# Vision models for image/PDF import
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_CLOUD_VISION_MODEL=qwen3-coder:480b-cloud
